rules_version = '2';

// Every tool in the hub stores its data under users/{uid}/app_data/{tool_id},
// and users/{uid}/app_data/global_store and dashboard_apps for shared state
// (theme, the tool list). This locks every document under a user's own
// users/{uid} subtree to that signed-in user only - nobody else can read or
// write it, including other signed-in users. Everything not matched here is
// denied by default, which is Firestore's default behaviour.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
